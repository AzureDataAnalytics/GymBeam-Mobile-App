# Copy to .env and fill in per environment. Never commit the real .env file.
# All EXPO_PUBLIC_* variables are bundled into the client and are NOT secret.
#
# There is no backend yet — that's an intentional, separate later phase (see
# docs/api-integration.md). Everything today runs on-device: local auth,
# and either the mock device transport or a real Bluetooth Classic link.

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# When "true", Devices/Sessions screens use the in-app mock device instead of
# a real Raspberry Pi. Required on iOS today — see docs/device-integration.md.
EXPO_PUBLIC_ENABLE_MOCK_DEVICE=true
